<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_4dof">

  <!-- ===================== PROPERTIES ===================== -->
  <!-- Base -->
  <xacro:property name="base_radius" value="0.06"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass" value="2.0"/>

  <!-- Link1 - Turret -->
  <xacro:property name="link1_radius" value="0.04"/>
  <xacro:property name="link1_height" value="0.15"/>
  <xacro:property name="link1_mass" value="1.0"/>

  <!-- Link2 - Upper arm -->
  <xacro:property name="link2_width" value="0.04"/>
  <xacro:property name="link2_depth" value="0.04"/>
  <xacro:property name="link2_length" value="0.25"/>
  <xacro:property name="link2_mass" value="0.8"/>

  <!-- Link3 - Forearm -->
  <xacro:property name="link3_width" value="0.03"/>
  <xacro:property name="link3_depth" value="0.03"/>
  <xacro:property name="link3_length" value="0.20"/>
  <xacro:property name="link3_mass" value="0.5"/>

  <!-- Link4 - Wrist (new 4th DOF: rotation around Z) -->
  <xacro:property name="link4_radius" value="0.025"/>
  <xacro:property name="link4_height" value="0.03"/>
  <xacro:property name="link4_mass" value="0.15"/>

  <!-- Gripper -->
  <xacro:property name="gripper_base_x" value="0.06"/>
  <xacro:property name="gripper_base_y" value="0.04"/>
  <xacro:property name="gripper_base_z" value="0.01"/>
  <xacro:property name="gripper_base_mass" value="0.1"/>

  <xacro:property name="finger_x" value="0.03"/>
  <xacro:property name="finger_y" value="0.01"/>
  <xacro:property name="finger_z" value="0.04"/>
  <xacro:property name="finger_mass" value="0.05"/>

  <!-- Camera -->
  <xacro:property name="camera_size" value="0.03"/>
  <xacro:property name="camera_mass" value="0.05"/>

  <!-- ===================== INERTIA MACROS ===================== -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(3*r*r+h*h)}" ixy="0" ixz="0"
               iyy="${(1.0/12.0)*m*(3*r*r+h*h)}" iyz="0"
               izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${(1.0/12.0)*m*(x*x+z*z)}" iyz="0"
               izz="${(1.0/12.0)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== LINKS & JOINTS ===================== -->

  <!-- World link (for fixed base) -->
  <link name="world"/>

  <!-- Base Link -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:cylinder_inertia m="${base_mass}" r="${base_radius}" h="${base_height}"/>
    <visual>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link1 - Turret (rotates around Z) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="2.0" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link1">
    <xacro:cylinder_inertia m="${link1_mass}" r="${link1_radius}" h="${link1_height}"/>
    <visual>
      <origin xyz="0 0 ${link1_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link1_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link2 - Upper arm (rotates around Y) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_height}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link2">
    <xacro:box_inertia m="${link2_mass}" x="${link2_width}" y="${link2_depth}" z="${link2_length}"/>
    <visual>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_width} ${link2_depth} ${link2_length}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.6 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_width} ${link2_depth} ${link2_length}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link3 - Forearm (rotates around Y) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="50.0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <link name="link3">
    <xacro:box_inertia m="${link3_mass}" x="${link3_width}" y="${link3_depth}" z="${link3_length}"/>
    <visual>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link3_width} ${link3_depth} ${link3_length}"/>
      </geometry>
      <material name="light_blue">
        <color rgba="0.4 0.7 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link3_width} ${link3_depth} ${link3_length}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link4 - Wrist (4th DOF: rotates around Z for wrist roll) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="3.0" effort="20.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link4">
    <xacro:cylinder_inertia m="${link4_mass}" r="${link4_radius}" h="${link4_height}"/>
    <visual>
      <origin xyz="0 0 ${link4_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link4_radius}" length="${link4_height}"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link4_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link4_radius}" length="${link4_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- End Effector (reference frame at the tip of wrist link4) -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="link4"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 ${link4_height}" rpy="0 0 0"/>
  </joint>

  <link name="end_effector_link"/>

  <!-- ===================== GRIPPER ===================== -->

  <!-- Gripper base (sits right at the end of link4/wrist) -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 ${gripper_base_z/2}" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base_link">
    <xacro:box_inertia m="${gripper_base_mass}" x="${gripper_base_x}" y="${gripper_base_y}" z="${gripper_base_z}"/>
    <visual>
      <geometry>
        <box size="${gripper_base_x} ${gripper_base_y} ${gripper_base_z}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${gripper_base_x} ${gripper_base_y} ${gripper_base_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- Left finger (prismatic along Y, opens outward +Y, extends in +Z) -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="finger_left_link"/>
    <origin xyz="0 ${finger_y/2} ${gripper_base_z/2 + finger_z/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" velocity="0.5" effort="20.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="finger_left_link">
    <xacro:box_inertia m="${finger_mass}" x="${finger_x}" y="${finger_y}" z="${finger_z}"/>
    <visual>
      <geometry>
        <box size="${finger_x} ${finger_y} ${finger_z}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${finger_x} ${finger_y} ${finger_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- Right finger (mimic of left, moves in -Y, extends in +Z) -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="finger_right_link"/>
    <origin xyz="0 ${-finger_y/2} ${gripper_base_z/2 + finger_z/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.03" upper="0.0" velocity="0.5" effort="20.0"/>
    <mimic joint="gripper_left_joint" multiplier="-1" offset="0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="finger_right_link">
    <xacro:box_inertia m="${finger_mass}" x="${finger_x}" y="${finger_y}" z="${finger_z}"/>
    <visual>
      <geometry>
        <box size="${finger_x} ${finger_y} ${finger_z}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${finger_x} ${finger_y} ${finger_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- Grasp Center (virtual reference frame located at the center of the finger pads) -->
  <joint name="grasp_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="grasp_link"/>
    <origin xyz="0 0 ${gripper_base_z + finger_z/2}" rpy="0 0 0"/>
  </joint>
  <link name="grasp_link"/>

  <!-- ===================== CAMERA ===================== -->

  <!-- Camera mount (fixed overhead, looking straight down) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.50" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="camera_link">
    <xacro:box_inertia m="${camera_mass}" x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
    <visual>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera optical frame (Z forward, X right, Y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_optical_link"/>

  <!-- ===================== INCLUDE ros2_control + Gazebo ===================== -->
  <xacro:include filename="$(find robot_4dof)/urdf/robot_4dof_ros2_control.xacro"/>
  <xacro:include filename="$(find robot_4dof)/urdf/robot_4dof_gazebo.xacro"/>

</robot>
