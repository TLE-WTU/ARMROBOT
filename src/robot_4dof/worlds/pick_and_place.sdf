<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="pick_and_place_world">

    <!-- Physics -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light type="point" name="fill_light">
      <pose>0 -2 3 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
      </attenuation>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table -->
    <model name="table">
      <static>true</static>
      <pose>0.30 0 0.125 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.40 0.40 0.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.40 0.40 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Object 1: Coffee Mug with handle -->
    <model name="coffee_mug">
      <pose>0.25 0.03 0.251 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>0.00002</ixx>
            <iyy>0.00002</iyy>
            <izz>0.00002</izz>
          </inertia>
        </inertial>
        <collision name="body_col">
          <pose>0 -0.005 0.0275 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0225</radius>
              <length>0.055</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="handle_col">
          <pose>0 0.026 0.0275 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 0.016 0.038</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/tienle/.gemini/antigravity/scratch/robot_3dof_ws/src/robot_3dof/meshes/objects/mug.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.9 0.15 0.15 1</ambient>
            <diffuse>0.9 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Object 2: Rubber Duck (organic curved surface) -->
    <model name="rubber_duck">
      <pose>0.34 -0.06 0.251 0 0 -0.5</pose>
      <link name="link">
        <inertial>
          <mass>0.035</mass>
          <inertia>
            <ixx>0.000015</ixx>
            <iyy>0.000015</iyy>
            <izz>0.000015</izz>
          </inertia>
        </inertial>
        <collision name="body_col">
          <pose>0 0 0.027 0 0 0</pose>
          <geometry>
            <box>
              <size>0.056 0.038 0.052</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/tienle/.gemini/antigravity/scratch/robot_3dof_ws/src/robot_3dof/meshes/objects/duck.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Object 3: Torus Toy (donut ring shape) -->
    <model name="torus_toy">
      <pose>0.30 0.08 0.251 0 0 0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.030</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="body_col">
          <pose>0 0 0.026 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.026</radius>
              <length>0.017</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/tienle/.gemini/antigravity/scratch/robot_3dof_ws/src/robot_3dof/meshes/objects/torus.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.8 1</ambient>
            <diffuse>0.1 0.7 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
