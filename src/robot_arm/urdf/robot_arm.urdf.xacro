<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm">

  <xacro:arg name="dof" default="6"/>
  <xacro:arg name="use_mesh" default="true"/>

  <!-- ===================== PROPERTIES ===================== -->
  <!-- Base -->
  <xacro:property name="base_radius" value="0.06"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass" value="2.0"/>

  <!-- Link1 - Turret -->
  <xacro:property name="link1_radius" value="0.04"/>
  <xacro:property name="link1_height" value="0.15"/>
  <xacro:property name="link1_mass" value="1.0"/>

  <!-- Link2 - Upper arm -->
  <xacro:property name="link2_width" value="0.04"/>
  <xacro:property name="link2_depth" value="0.04"/>
  <xacro:property name="link2_length" value="0.25"/>
  <xacro:property name="link2_mass" value="0.8"/>

  <!-- Link3 - Forearm -->
  <xacro:property name="link3_width" value="0.03"/>
  <xacro:property name="link3_depth" value="0.03"/>
  <xacro:property name="link3_length" value="0.20"/>
  <xacro:property name="link3_mass" value="0.5"/>

  <!-- Link4 - Wrist (4th DOF: wrist pitch around Y) -->
  <xacro:property name="link4_radius" value="0.025"/>
  <xacro:property name="link4_height" value="0.03"/>
  <xacro:property name="link4_mass" value="0.15"/>

  <!-- Link5 - Wrist Pitch/Yaw (5th DOF: rotates around X or Z) -->
  <xacro:property name="link5_radius" value="0.025"/>
  <xacro:property name="link5_height" value="0.02"/>
  <xacro:property name="link5_mass" value="0.1"/>

  <!-- Link6 - Tool Flange / Wrist Roll (6th DOF: tool roll around Z) -->
  <xacro:property name="link6_radius" value="0.025"/>
  <xacro:property name="link6_height" value="0.02"/>
  <xacro:property name="link6_mass" value="0.08"/>

  <!-- Gripper -->
  <xacro:property name="gripper_base_x" value="0.06"/>
  <xacro:property name="gripper_base_y" value="0.04"/>
  <xacro:property name="gripper_base_z" value="0.01"/>
  <xacro:property name="gripper_base_mass" value="0.1"/>

  <xacro:property name="finger_x" value="0.03"/>
  <xacro:property name="finger_y" value="0.01"/>
  <xacro:property name="finger_z" value="0.04"/>
  <xacro:property name="finger_mass" value="0.05"/>

  <!-- Camera -->
  <xacro:property name="camera_size" value="0.03"/>
  <xacro:property name="camera_mass" value="0.05"/>

  <!-- ===================== INERTIA MACROS ===================== -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(3*r*r+h*h)}" ixy="0" ixz="0"
               iyy="${(1.0/12.0)*m*(3*r*r+h*h)}" iyz="0"
               izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${(1.0/12.0)*m*(x*x+z*z)}" iyz="0"
               izz="${(1.0/12.0)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== LINKS & JOINTS ===================== -->

  <!-- World link (for fixed base) -->
  <link name="world"/>

  <!-- Base Link -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:cylinder_inertia m="${base_mass}" r="${base_radius}" h="${base_height}"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/arm/base_link.stl"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <geometry>
          <cylinder radius="${base_radius}" length="${base_height}"/>
        </geometry>
      </xacro:unless>
      <material name="dark_slate">
        <color rgba="0.18 0.22 0.26 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link1 - Turret (rotates around Z) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="2.0" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link1">
    <xacro:cylinder_inertia m="${link1_mass}" r="${link1_radius}" h="${link1_height}"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/arm/link1.stl"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <origin xyz="0 0 ${link1_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link1_radius}" length="${link1_height}"/>
        </geometry>
      </xacro:unless>
      <material name="slate_grey">
        <color rgba="0.22 0.28 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link1_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link2 - Upper arm (rotates around Y) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_height}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link2">
    <xacro:box_inertia m="${link2_mass}" x="${link2_width}" y="${link2_depth}" z="${link2_length}"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/arm/link2.stl"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${link2_width} ${link2_depth} ${link2_length}"/>
        </geometry>
      </xacro:unless>
      <material name="metallic_silver">
        <color rgba="0.65 0.70 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_width} ${link2_depth} ${link2_length}"/>
      </geometry>
    </collision>
  </link>

  <!-- Link3 - Forearm (rotates around Y) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="50.0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <link name="link3">
    <xacro:box_inertia m="${link3_mass}" x="${link3_width}" y="${link3_depth}" z="${link3_length}"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/arm/link3.stl"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${link3_width} ${link3_depth} ${link3_length}"/>
        </geometry>
      </xacro:unless>
      <material name="aluminum">
        <color rgba="0.70 0.75 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link3_width} ${link3_depth} ${link3_length}"/>
      </geometry>
    </collision>
  </link>

  <xacro:if value="${$(arg dof) >= 4}">
    <!-- Link4 - Wrist (4th DOF: rotates around Y for wrist pitch) -->
    <joint name="joint4" type="revolute">
      <parent link="link3"/>
      <child link="link4"/>
      <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.2" upper="2.2" velocity="3.0" effort="20.0"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>

    <link name="link4">
      <xacro:cylinder_inertia m="${link4_mass}" r="${link4_radius}" h="${link4_height}"/>
      <visual>
        <xacro:if value="$(arg use_mesh)">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://robot_arm/meshes/arm/link4.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="$(arg use_mesh)">
          <origin xyz="0 0 ${link4_height/2}" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="${link4_radius}" length="${link4_height}"/>
          </geometry>
        </xacro:unless>
        <material name="wrist_dark">
          <color rgba="0.25 0.30 0.35 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${link4_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link4_radius}" length="${link4_height}"/>
        </geometry>
      </collision>
    </link>
  </xacro:if>

  <xacro:if value="${$(arg dof) == 5}">
    <joint name="joint5" type="revolute">
      <parent link="link4"/>
      <child link="link5"/>
      <origin xyz="0 0 ${link4_height}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="${pi/2}" velocity="3.0" effort="20.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <link name="link5">
      <xacro:cylinder_inertia m="${link5_mass}" r="${link5_radius}" h="${link5_height}"/>
      <visual>
        <xacro:if value="$(arg use_mesh)">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://robot_arm/meshes/arm/link5.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="$(arg use_mesh)">
          <origin xyz="0 0 ${link5_height/2}" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="${link5_radius}" length="${link5_height}"/>
          </geometry>
        </xacro:unless>
        <material name="flange_dark">
          <color rgba="0.18 0.22 0.26 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${link5_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link5_radius}" length="${link5_height}"/>
        </geometry>
      </collision>
    </link>
  </xacro:if>

  <xacro:if value="${$(arg dof) >= 6}">
    <!-- Joint 5 - Wrist Pitch/Yaw (rotates around X) -->
    <joint name="joint5" type="revolute">
      <parent link="link4"/>
      <child link="link5"/>
      <origin xyz="0 0 ${link4_height}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.5" upper="2.5" velocity="3.0" effort="20.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <link name="link5">
      <xacro:cylinder_inertia m="${link5_mass}" r="${link5_radius}" h="${link5_height}"/>
      <visual>
        <xacro:if value="$(arg use_mesh)">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://robot_arm/meshes/arm/link5.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="$(arg use_mesh)">
          <origin xyz="0 0 ${link5_height/2}" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="${link5_radius}" length="${link5_height}"/>
          </geometry>
        </xacro:unless>
        <material name="wrist_dark">
          <color rgba="0.25 0.30 0.35 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${link5_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link5_radius}" length="${link5_height}"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint 6 - Tool Flange / Wrist Roll (rotates around Z) -->
    <joint name="joint6" type="revolute">
      <parent link="link5"/>
      <child link="link6"/>
      <origin xyz="0 0 ${link5_height}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" velocity="3.0" effort="20.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <link name="link6">
      <xacro:cylinder_inertia m="${link6_mass}" r="${link6_radius}" h="${link6_height}"/>
      <visual>
        <origin xyz="0 0 ${link6_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link6_radius}" length="${link6_height}"/>
        </geometry>
        <material name="flange_dark">
          <color rgba="0.18 0.22 0.26 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${link6_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link6_radius}" length="${link6_height}"/>
        </geometry>
      </collision>
    </link>
  </xacro:if>

  <!-- End Effector (reference frame at the tip of the last link) -->
  <xacro:if value="${$(arg dof) == 3}">
    <joint name="end_effector_joint" type="fixed">
      <parent link="link3"/>
      <child link="end_effector_link"/>
      <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
    </joint>
  </xacro:if>
  <xacro:if value="${$(arg dof) == 4}">
    <joint name="end_effector_joint" type="fixed">
      <parent link="link4"/>
      <child link="end_effector_link"/>
      <origin xyz="0 0 ${link4_height}" rpy="0 0 0"/>
    </joint>
  </xacro:if>
  <xacro:if value="${$(arg dof) == 5}">
    <joint name="end_effector_joint" type="fixed">
      <parent link="link5"/>
      <child link="end_effector_link"/>
      <origin xyz="0 0 ${link5_height}" rpy="0 0 0"/>
    </joint>
  </xacro:if>
  <xacro:if value="${$(arg dof) >= 6}">
    <joint name="end_effector_joint" type="fixed">
      <parent link="link6"/>
      <child link="end_effector_link"/>
      <origin xyz="0 0 ${link6_height}" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <link name="end_effector_link"/>

  <!-- ===================== GRIPPER (Franka Hand Modern Parallel-Jaw) ===================== -->

  <!-- Gripper base (sits right at the end of the arm) -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base_link">
    <xacro:box_inertia m="${gripper_base_mass}" x="0.06" y="0.12" z="0.06"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/gripper/hand.dae"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <origin xyz="0 0 ${gripper_base_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${gripper_base_x} ${gripper_base_y} ${gripper_base_z}"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </xacro:unless>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.12 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Left finger (prismatic along Y, opens outward +Y, extends in +Z) -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="finger_left_link"/>
    <origin xyz="0 0 0.0584" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.035" velocity="0.5" effort="20.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="finger_left_link">
    <xacro:box_inertia m="${finger_mass}" x="0.02" y="0.015" z="0.04"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/gripper/finger.dae"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${finger_z}"/>
        </geometry>
        <material name="light_grey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </xacro:unless>
    </visual>
    <collision>
      <origin xyz="0 0.0075 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.015 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Right finger (mimic of left, moves in -Y, extends in +Z) -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="finger_right_link"/>
    <origin xyz="0 0 0.0584" rpy="0 0 ${pi}"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.035" velocity="0.5" effort="20.0"/>
    <mimic joint="gripper_left_joint" multiplier="1" offset="0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="finger_right_link">
    <xacro:box_inertia m="${finger_mass}" x="0.02" y="0.015" z="0.04"/>
    <visual>
      <xacro:if value="$(arg use_mesh)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_arm/meshes/gripper/finger.dae"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_mesh)">
        <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${finger_z}"/>
        </geometry>
        <material name="light_grey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </xacro:unless>
    </visual>
    <collision>
      <origin xyz="0 0.0075 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.015 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Grasp Center (virtual reference frame located at the center of the finger pads) -->
  <joint name="grasp_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="grasp_link"/>
    <origin xyz="0 0 0.1034" rpy="0 0 0"/>
  </joint>
  <link name="grasp_link"/>

  <!-- ===================== CAMERA ===================== -->

  <!-- Camera mount (fixed overhead, looking straight down) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.50" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="camera_link">
    <xacro:box_inertia m="${camera_mass}" x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
    <visual>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera optical frame (Z forward, X right, Y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_optical_link"/>

  <!-- ===================== DUAL DYNAMIC CAMERAS ===================== -->

  <!-- Dynamic Camera 1: Wrist Eye-in-Hand Camera (moves with gripper) -->
  <joint name="camera_wrist_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="camera_wrist_link"/>
    <origin xyz="0.04 0.0 0.02" rpy="0 0.35 0"/>
  </joint>

  <link name="camera_wrist_link">
    <xacro:box_inertia m="${camera_mass}" x="0.025" y="0.05" z="0.02"/>
    <visual>
      <geometry>
        <box size="0.025 0.05 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.05 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_wrist_optical_joint" type="fixed">
    <parent link="camera_wrist_link"/>
    <child link="camera_wrist_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_wrist_optical_link"/>

  <!-- Dynamic Camera 2: Arm Turret Tracking Camera (moves with joint1 base yaw) -->
  <joint name="camera_arm_joint" type="fixed">
    <parent link="link1"/>
    <child link="camera_arm_link"/>
    <origin xyz="0.06 0.0 0.14" rpy="0 0.60 0"/>
  </joint>

  <link name="camera_arm_link">
    <xacro:box_inertia m="${camera_mass}" x="0.03" y="0.05" z="0.025"/>
    <visual>
      <geometry>
        <box size="0.03 0.05 0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.05 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_arm_optical_joint" type="fixed">
    <parent link="camera_arm_link"/>
    <child link="camera_arm_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_arm_optical_link"/>

  <!-- ===================== INCLUDE ros2_control + Gazebo ===================== -->
  <xacro:include filename="$(find robot_arm)/urdf/robot_arm_ros2_control.xacro"/>
  <xacro:include filename="$(find robot_arm)/urdf/robot_arm_gazebo.xacro"/>

</robot>
